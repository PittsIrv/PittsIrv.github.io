---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const navItems = [{ href: '/', label: 'Home' }, { href: '/work', label: 'Work' }, { href: '/personal', label: 'Personal' }, { href: '/about', label: 'About' }];
---
<a class="skip-link" href="#main-content">Skip to content</a>
<nav class="site-nav" aria-label="Main navigation">
  <div class="page-shell nav-inner">
    <a href="/" class="site-wordmark">Mingxi Yan<span aria-hidden="true">.</span></a>
    <div class="nav-links">{navItems.map(item => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}</div>
  </div>
</nav>
