---
// Ask my standin (standin site-demo spec §2). Renders only when the server's address is set at build time, and stays
// hidden until the server says it's healthy, so it never shows broken.
const url = import.meta.env.PUBLIC_STANDIN_URL;
---

{url && (
  <div class="standin-chat mt-5" data-url={url} hidden>
    <form class="flex gap-2">
      <label for="standin-question" class="sr-only">Ask my standin</label>
      <input
        id="standin-question"
        name="question"
        maxlength="500"
        placeholder="Ask me anything"
        autocomplete="off"
        class="flex-1 min-w-0 border border-gray-300 bg-white px-3 py-2 font-serif text-[1.0625rem] focus:outline-none focus:border-black"
      />
      <button class="shrink-0 border border-black px-4 py-2 text-sm font-medium hover:bg-black hover:text-white transition-colors disabled:opacity-40 disabled:hover:bg-transparent disabled:hover:text-black">Ask</button>
    </form>
    <ol class="mt-4 space-y-4" aria-live="polite"></ol>
    <p class="mt-3 text-xs text-gray-500">Questions it can't answer are kept for 90 days, without who asked.</p>
  </div>
)}

<script>
  const FAILED = "Something went wrong. Please try again.";

  for (const box of document.querySelectorAll<HTMLElement>(".standin-chat")) {
    const base = (box.dataset.url ?? "").replace(/\/$/, "");
    const form = box.querySelector("form")!;
    const input = box.querySelector("input")!;
    const button = box.querySelector("button")!;
    const list = box.querySelector("ol")!;

    fetch(`${base}/v1/health`)
      .then((r) => r.json())
      .then((h: { ok?: boolean }) => {
        if (h.ok) box.hidden = false;
      })
      .catch(() => {});

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const question = input.value.trim();
      if (!question) return;
      const item = document.createElement("li");
      const asked = document.createElement("p");
      asked.className = "text-sm text-gray-500";
      asked.textContent = question;
      const reply = document.createElement("p");
      reply.className = "mt-1 text-gray-800 leading-relaxed font-serif text-[1.0625rem]";
      reply.textContent = "…";
      item.append(asked, reply);
      list.prepend(item);
      input.value = "";
      button.disabled = true;
      try {
        const r = await fetch(`${base}/v1/ask`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ question }) });
        const body = (await r.json().catch(() => ({}))) as { text?: string; error?: string };
        // The server's own messages (too many questions, a secret, the month's budget) read as replies.
        reply.textContent = body.text ?? body.error ?? FAILED;
      } catch {
        reply.textContent = FAILED;
      } finally {
        button.disabled = false;
        input.focus();
      }
    });
  }
</script>
