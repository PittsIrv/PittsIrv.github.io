---
// Floating MeeTwo: a corner button on every page that opens the chat in a panel. Rendered only when the API address is set.
import MeeTwoChat from './MeeTwoChat.astro';
const url = import.meta.env.PUBLIC_STANDIN_URL;
---

{url && (
  <div id="meetwo-launcher">
    <section id="meetwo-panel" role="dialog" aria-label="MeeTwo" tabindex="-1" hidden>
      <header>
        <span>MeeTwo</span>
        <button type="button" class="ml-close" aria-label="Close MeeTwo">×</button>
      </header>
      <div class="ml-body"><MeeTwoChat standalone /></div>
    </section>
    <button type="button" class="ml-fab" aria-label="Ask MeeTwo" aria-expanded="false" aria-controls="meetwo-panel">
      <span class="ml-mark" aria-hidden="true">M</span><span class="ml-label">Ask MeeTwo</span>
    </button>
  </div>
)}

<script>
  const root = document.getElementById("meetwo-launcher");
  if (root) {
    const panel = root.querySelector<HTMLElement>("#meetwo-panel")!;
    const fab = root.querySelector<HTMLButtonElement>(".ml-fab")!;
    const KEY = "meetwo:open";
    const set = (open: boolean) => {
      panel.hidden = !open;
      fab.hidden = open;
      fab.setAttribute("aria-expanded", String(open));
      try { sessionStorage.setItem(KEY, open ? "1" : "0"); } catch {}
      if (open) panel.focus({ preventScroll: true });
      else fab.focus({ preventScroll: true });
    };
    fab.addEventListener("click", () => set(true));
    root.querySelector(".ml-close")!.addEventListener("click", () => set(false));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !panel.hidden) set(false); });
    let wasOpen = false;
    try { wasOpen = sessionStorage.getItem(KEY) === "1"; } catch {}
    if (wasOpen) { panel.hidden = false; fab.hidden = true; fab.setAttribute("aria-expanded", "true"); }
  }
</script>

<style is:global>
  /* Placement keeps the button off the text column: in the nav bar's reserved right slot below 1200px, in the side gutter above it (mark only), with its label once the gutter fits it. */
  #meetwo-launcher { position: fixed; z-index: 60; top: .5rem; right: clamp(1.25rem, 4vw, 3rem); display: flex; flex-direction: column; align-items: flex-end; }
  body:has(#meetwo-launcher) .nav-inner { padding-right: calc(clamp(1.25rem, 4vw, 3rem) + 3.5rem); }
  #meetwo-launcher .ml-label { display: none; }
  #meetwo-launcher .ml-fab { padding: 0 .5rem; }
  @media (min-width: 641px) { #meetwo-launcher { top: 1.0625rem; } }
  @media (min-width: 1200px) {
    #meetwo-launcher { top: auto; bottom: 1rem; right: 1rem; }
    body:has(#meetwo-launcher) .nav-inner { padding-right: clamp(1.25rem, 4vw, 3rem); }
  }
  @media (min-width: 1440px) {
    #meetwo-launcher .ml-label { display: inline; }
    #meetwo-launcher .ml-fab { padding: 0 1rem 0 .5rem; }
  }
  #meetwo-launcher .ml-fab { display: inline-flex; align-items: center; gap: .5rem; height: 2.75rem; border: 1px solid #000; background: #fff; color: #000; font: 500 .875rem/1 var(--font-sans, system-ui, sans-serif); box-shadow: 0 2px 10px rgb(0 0 0 / .12); cursor: pointer; }
  #meetwo-launcher .ml-fab[hidden], #meetwo-launcher #meetwo-panel[hidden] { display: none; }
  #meetwo-launcher .ml-fab:hover { background: #000; color: #fff; }
  #meetwo-launcher .ml-mark { display: grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: #000; color: #fff; font-family: var(--font-serif, serif); font-size: .9375rem; }
  #meetwo-launcher .ml-fab:hover .ml-mark { background: #fff; color: #000; }
  #meetwo-panel { width: min(24rem, calc(100vw - 2rem)); max-height: min(34rem, calc(100dvh - 2rem)); display: flex; flex-direction: column; border: 1px solid #000; background: #fff; box-shadow: 0 4px 24px rgb(0 0 0 / .18); }
  #meetwo-panel header { display: flex; justify-content: space-between; align-items: center; padding: .5rem .75rem; border-bottom: 1px solid #e5e5e5; font: 600 .875rem/1 var(--font-sans, system-ui, sans-serif); }
  #meetwo-panel .ml-close { border: 0; background: none; font-size: 1.5rem; line-height: 1; padding: .25rem .5rem; cursor: pointer; }
  #meetwo-panel .ml-body { overflow-y: auto; padding: 0 .75rem .75rem; }
  #meetwo-panel .meetwo-chat { margin-top: .75rem; }
</style>
