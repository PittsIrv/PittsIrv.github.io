---
import '../styles/global.css';
import MeeTwoLauncher from '../components/MeeTwoLauncher.astro';
import { buildCsp } from '../csp.mjs';
import { existsSync } from 'node:fs';

interface Props {
  title: string;
  description?: string;
  launcher?: boolean;
}

const { launcher = true, title, description = "Mingxi Yan - AI systems engineer and CMU Language Technologies master's student. Previously Data Engineer Intern at TikTok." } = Astro.props;
const hasMeeTwo = launcher && Boolean(import.meta.env.PUBLIC_STANDIN_URL);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const slug = Astro.url.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'home';
// A page without its own committed image (a poem or article added from /admin) uses the home image.
const ownImage = existsSync(`public/og/${slug}.png`);
const imageURL = new URL(`/og/${ownImage ? slug : 'home'}.png`, Astro.site).href;
const imageAlt = `${title}`;

const csp = buildCsp(import.meta.env.PUBLIC_STANDIN_URL, Astro.url);

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Mingxi Yan: writing (RSS)" href="/rss.xml" />
    <link rel="alternate" type="application/atom+xml" title="Mingxi Yan: writing (Atom)" href="/atom.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="j7sXWvTqcvO3vj3_QABlB9g5QmT2y2ovGhN5Rlh7s4g" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Mingxi Yan" />
    <meta name="keywords" content="Mingxi Yan, AI engineer, machine learning, software engineer, Carnegie Mellon, Language Technologies Institute, TikTok, PersonaTeaming, retrieval, LLM systems" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Mingxi Yan" />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageURL} />
    <meta property="twitter:image:alt" content={imageAlt} />

    <!-- Structured Data for Search Engines -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Mingxi Yan",
        "url": "https://pittsirv.github.io",
        "sameAs": [],
        "jobTitle": "AI Systems Engineer",
        "alumniOf": "Carnegie Mellon University",
        "description": "AI systems engineer and CMU Language Technologies master's student."
      }
    </script>
  </head>
  <body class:list={["bg-white text-black antialiased", { "has-meetwo": hasMeeTwo }]}>
    <div class="min-h-screen flex flex-col">
      <slot />
    </div>
    {launcher && <MeeTwoLauncher />}
  </body>
</html>
