---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import projectData from '../data/projects.json';

const order = ['active', 'shipped', 'paused', 'archived'];
const visibilities = ['public', 'title'];
const datePattern = /^(\d{4}-(0[1-9]|1[0-2])|now|unknown)$/;
for (const p of projectData) {
  const bad = !order.includes(p.status) ? 'status' : !visibilities.includes(p.visibility) ? 'visibility'
    : !datePattern.test(p.period.start) || !datePattern.test(p.period.end) ? 'period' : null;
  if (bad) throw new Error(`projects.json: invalid ${bad} for "${p.name}"`);
}
const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const heading: Record<string, string> = { active: 'Active', shipped: 'Shipped', paused: 'Paused', archived: 'Archived' };
const visible = projectData.filter(p => p.visibility === 'public' || p.visibility === 'title');
const groups = order
  .map(status => ({ status, items: visible.filter(p => p.status === status) }))
  .filter(g => g.items.length > 0);

// Text-only list: public entries, one line each; the name jumps to the entry, plus the live site, public repo or paper when there is one.
const summary = order.flatMap(status => visible.filter(p => p.status === status && p.visibility === 'public')).map(p => {
  const links = p.links as Record<string, string>;
  const key = (['site', 'repo', 'paper'] as const).find(k => links[k]);
  return { name: p.name, anchor: `#${slug(p.name)}`, line: p.oneLine, href: key && links[key], label: key && { site: 'Site', repo: 'Repository', paper: 'Paper' }[key] };
});

const fmt = (d: string) => {
  if (d === 'now') return 'Present';
  const [y, m] = d.split('-');
  const names = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  return m ? `${names[Number(m) - 1]} ${y}` : y;
};
const linkLabels: Record<string, string> = { site: 'Site', repo: 'Repository', paper: 'Paper' };
---
<Layout title="Projects - Mingxi Yan" description="Projects by Mingxi Yan, grouped by status.">
  <Navigation />
  <main id="main-content" class="flex-grow">
    <section class="pt-16 pb-10 px-4 sm:px-6 lg:px-8 border-b border-gray-200">
      <div class="max-w-5xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-semibold tracking-tight mb-5">Projects</h1>
        <p class="text-lg text-gray-700 max-w-2xl leading-relaxed font-serif">Current and past projects, active first.</p>
      </div>
    </section>

    <section id="list" class="pt-10 px-4 sm:px-6 lg:px-8 scroll-mt-16" aria-label="Projects at a glance">
      <ul class="max-w-5xl mx-auto project-list">
        {summary.map(p => (
          <li>
            <a class="pl-name" href={p.anchor}>{p.name}</a>
            <span class="pl-line">{p.line}</span>
            {p.href && <a class="pl-link" href={p.href} target="_blank" rel="noopener noreferrer">{p.label} <span aria-hidden="true">↗</span></a>}
          </li>
        ))}
      </ul>
    </section>

    {groups.map(group => (
      <section id={group.status} class="pt-14 pb-4 px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <h2 class="group-heading">{heading[group.status]}</h2>
          {group.items.map(p => (
            <article class="entry" id={slug(p.name)}>
              <header class="entry-top">
                <h3>{p.name}</h3>
                {p.visibility === 'public' && <p class="entry-period">{fmt(p.period.start)} – {fmt(p.period.end)}</p>}
              </header>
              <div class="entry-facts">
                <p class="entry-line">{p.oneLine}</p>
                {p.visibility === 'public' && p.did.length > 0 && <ul class="entry-did">{p.did.map(b => <li>{b}</li>)}</ul>}
                <div class="entry-foot">
                  {p.visibility === 'public' && p.tags.length > 0 && <ul class="entry-tags" aria-label="Stack">{p.tags.map(t => <li>{t}</li>)}</ul>}
                  {p.visibility === 'public' && Object.keys(p.links).length > 0 && (
                    <p class="entry-links">
                      {Object.entries(p.links).map(([k, href]) => (
                        <a href={href as string} target="_blank" rel="noopener noreferrer">{linkLabels[k] ?? k} <span aria-hidden="true">↗</span></a>
                      ))}
                    </p>
                  )}
                  {'comingSoon' in p && <p class="entry-soon">{p.comingSoon}: coming soon</p>}
                </div>
              </div>
              {p.intuition && <aside class="entry-intuition" aria-label={`Intuition: ${p.name}`}><h4>Intuition</h4><p>{p.intuition}</p></aside>}
            </article>
          ))}
        </div>
      </section>
    ))}
  </main>
  <Footer />
</Layout>

<style>
  .project-list { border-top: 1px solid var(--line); }
  .project-list li { display: grid; grid-template-columns: 11rem 1fr auto; gap: .25rem 1.5rem; align-items: baseline; padding: .8rem 0; border-bottom: 1px solid var(--line); }
  .pl-name { font-family: var(--font-serif); font-weight: 500; text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: .25em; }
  .pl-name:hover { color: var(--accent); text-decoration-color: currentColor; }
  .pl-line { font-family: var(--font-serif); color: var(--muted); line-height: 1.5; }
  .pl-link { grid-column: 3; font-size: .875rem; border-bottom: 1px solid var(--line); white-space: nowrap; justify-self: start; }
  .pl-link:hover { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 640px) { .project-list li { grid-template-columns: 1fr; } .pl-link { grid-column: auto; } }
  .group-heading { font-family: var(--font-serif); font-size: 1.75rem; font-weight: 500; letter-spacing: -.02em; margin-bottom: .75rem; }
  /* One row per project: facts on the left, the Intuition beside them on wide screens and after them below 900px. Without an Intuition the facts keep their 7-part width so lines stay readable. */
  .entry { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 1rem 3rem; padding-block: 1.75rem 2rem; border-top: 1px solid var(--line); }
  .entry-top { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .25rem 1.5rem; }
  .entry-top h3 { font-family: var(--font-serif); font-size: 1.625rem; font-weight: 600; letter-spacing: -.015em; line-height: 1.2; }
  .entry-period { font-size: .9375rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .entry-facts { display: flex; flex-direction: column; gap: .9rem; min-width: 0; }
  .entry-line { font-family: var(--font-serif); font-size: 1.1875rem; line-height: 1.5; }
  .entry-did { list-style: disc; padding-left: 1.15rem; font-size: 1rem; line-height: 1.55; }
  .entry-did li + li { margin-top: .45rem; }
  .entry-did li::marker { color: var(--muted); }
  .entry-foot { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1.25rem; }
  .entry-tags { display: flex; flex-wrap: wrap; gap: .375rem; }
  .entry-tags li { font-size: .8125rem; line-height: 1.4; background: var(--wash); color: var(--ink); padding: .2rem .5rem; border-radius: 3px; }
  .entry-links { display: flex; flex-wrap: wrap; gap: 1.25rem; font-size: .9375rem; }
  .entry-links a { color: var(--accent); border-bottom: 1px solid #a7b8e5; }
  .entry-links a:hover { border-color: currentColor; }
  .entry-soon { font-size: .9375rem; color: var(--muted); }
  .entry-intuition { align-self: start; background: var(--wash); padding: 1.15rem 1.35rem 1.3rem; min-width: 0; }
  .entry-intuition h4 { font-family: var(--font-sans); font-size: .875rem; font-weight: 600; color: var(--muted); margin-bottom: .45rem; }
  .entry-intuition p { font-family: var(--font-serif); font-size: 1.03rem; line-height: 1.65; color: var(--ink); }
  @media (max-width: 899px) { .entry { grid-template-columns: 1fr; } .entry-top h3 { font-size: 1.45rem; } }
</style>
