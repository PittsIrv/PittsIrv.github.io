---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Misc - Mingxi Yan">
  <Navigation />

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-gray-50 to-white">
      <div class="max-w-5xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-bold mb-6 opacity-0 animate-fade-in-up">Miscellaneous</h1>
        <p class="text-xl text-gray-600 max-w-3xl opacity-0 animate-fade-in-up delay-100">
          Random thoughts, interests, hobbies, and the bits that don't fit neatly into other categories.
        </p>
      </div>
    </section>

    <!-- Current Interests -->
    <section class="py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 flex items-center">
          <span class="w-12 h-1 bg-black mr-4"></span>
          Currently Exploring
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-white border border-gray-200 p-6 hover:shadow-lg transition-all duration-300">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-black text-white flex items-center justify-center mr-4">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                </svg>
              </div>
              <h3 class="text-xl font-bold">Music Production</h3>
            </div>
            <p class="text-gray-600 leading-relaxed">
              Learning electronic music production and sound design. Currently exploring the intersection of algorithmic composition and human creativity.
            </p>
          </div>

          <div class="bg-white border border-gray-200 p-6 hover:shadow-lg transition-all duration-300">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-black text-white flex items-center justify-center mr-4">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <h3 class="text-xl font-bold">Photography</h3>
            </div>
            <p class="text-gray-600 leading-relaxed">
              Street and landscape photography. Capturing moments of unexpected beauty and geometric patterns in everyday life.
            </p>
          </div>

          <div class="bg-white border border-gray-200 p-6 hover:shadow-lg transition-all duration-300">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-black text-white flex items-center justify-center mr-4">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>
              <h3 class="text-xl font-bold">Reading List</h3>
            </div>
            <p class="text-gray-600 leading-relaxed">
              Deep dives into philosophy, mathematics, and science fiction. Currently reading works on game theory and decision theory.
            </p>
          </div>

          <div class="bg-white border border-gray-200 p-6 hover:shadow-lg transition-all duration-300">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-black text-white flex items-center justify-center mr-4">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />
                </svg>
              </div>
              <h3 class="text-xl font-bold">Chess</h3>
            </div>
            <p class="text-gray-600 leading-relaxed">
              Another strategic game that fascinates me. The perfect information aspect contrasts beautifully with poker's hidden information.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sports -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-gray-50">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 flex items-center">
          <span class="w-12 h-1 bg-black mr-4"></span>
          Sports I Play
        </h2>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          <div class="flex items-center justify-between p-3 bg-white border border-gray-200">
            <span class="font-medium">Basketball</span>
            <span class="text-xs px-2 py-1 bg-green-100 text-green-700 rounded">Good</span>
          </div>
          <div class="flex items-center justify-between p-3 bg-white border border-gray-200">
            <span class="font-medium">Ping Pong</span>
            <span class="text-xs px-2 py-1 bg-green-100 text-green-700 rounded">Good</span>
          </div>
          <div class="flex items-center justify-between p-3 bg-white border border-gray-200">
            <span class="font-medium">Pool</span>
            <span class="text-xs px-2 py-1 bg-yellow-100 text-yellow-700 rounded">Med</span>
          </div>
          <div class="flex items-center justify-between p-3 bg-white border border-gray-200">
            <span class="font-medium">Frisbee</span>
            <span class="text-xs px-2 py-1 bg-yellow-100 text-yellow-700 rounded">Med</span>
          </div>
          <div class="flex items-center justify-between p-3 bg-white border border-gray-200">
            <span class="font-medium">Badminton</span>
            <span class="text-xs px-2 py-1 bg-yellow-100 text-yellow-700 rounded">Med</span>
          </div>
          <div class="flex items-center justify-between p-3 bg-white border border-gray-200">
            <span class="font-medium">Volleyball</span>
            <span class="text-xs px-2 py-1 bg-gray-100 text-gray-700 rounded">Low</span>
          </div>
          <div class="flex items-center justify-between p-3 bg-white border border-gray-200">
            <span class="font-medium">Football</span>
            <span class="text-xs px-2 py-1 bg-gray-100 text-gray-700 rounded">Low</span>
          </div>
          <div class="flex items-center justify-between p-3 bg-white border border-gray-200">
            <span class="font-medium">Tennis</span>
            <span class="text-xs px-2 py-1 bg-gray-100 text-gray-700 rounded">Low</span>
          </div>
          <div class="flex items-center justify-between p-3 bg-white border border-gray-200">
            <span class="font-medium">Soccer</span>
            <span class="text-xs px-2 py-1 bg-gray-100 text-gray-700 rounded">Low</span>
          </div>
          <div class="flex items-center justify-between p-3 bg-white border border-gray-200">
            <span class="font-medium">Golf</span>
            <span class="text-xs px-2 py-1 bg-gray-100 text-gray-700 rounded">Low</span>
          </div>
          <div class="flex items-center justify-between p-3 bg-white border border-gray-200">
            <span class="font-medium">Climbing</span>
            <span class="text-xs px-2 py-1 bg-gray-100 text-gray-700 rounded">Low</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Random Facts -->
    <section class="py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 flex items-center">
          <span class="w-12 h-1 bg-black mr-4"></span>
          Random Facts About Me
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 text-center">
            <div class="text-4xl mb-3">☕</div>
            <p class="text-gray-600">Powered by coffee and curiosity</p>
          </div>

          <div class="bg-white p-6 text-center">
            <div class="text-4xl mb-3">🌙</div>
            <p class="text-gray-600">Night owl - best code written after midnight</p>
          </div>

          <div class="bg-white p-6 text-center">
            <div class="text-4xl mb-3">🎮</div>
            <p class="text-gray-600">Occasional gamer, strategic games preferred</p>
          </div>

          <div class="bg-white p-6 text-center">
            <div class="text-4xl mb-3">🎵</div>
            <p class="text-gray-600">Code to lo-fi, write to classical</p>
          </div>

          <div class="bg-white p-6 text-center">
            <div class="text-4xl mb-3">🌍</div>
            <p class="text-gray-600">Always planning the next adventure</p>
          </div>

          <div class="bg-white p-6 text-center">
            <div class="text-4xl mb-3">📚</div>
            <p class="text-gray-600">Perpetual student of everything</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Favorite Tools -->
    <section class="py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 flex items-center">
          <span class="w-12 h-1 bg-black mr-4"></span>
          Tools I Love
        </h2>

        <div class="space-y-6">
          <div class="bg-white border-l-4 border-black p-6">
            <h3 class="text-xl font-bold mb-2">Editor</h3>
            <p class="text-gray-600">VS Code with custom themes and keybindings. Vim mode enabled because old habits die hard.</p>
          </div>

          <div class="bg-white border-l-4 border-black p-6">
            <h3 class="text-xl font-bold mb-2">Terminal</h3>
            <p class="text-gray-600">iTerm2 with oh-my-zsh. A beautiful terminal is essential for a happy developer.</p>
          </div>

          <div class="bg-white border-l-4 border-black p-6">
            <h3 class="text-xl font-bold mb-2">Note-taking</h3>
            <p class="text-gray-600">Obsidian for connected thoughts, markdown for everything. Building a second brain, one note at a time.</p>
          </div>

          <div class="bg-white border-l-4 border-black p-6">
            <h3 class="text-xl font-bold mb-2">Design</h3>
            <p class="text-gray-600">Figma for quick mockups, pen and paper for initial sketches. Sometimes analog is best.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Currently Reading/Watching -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-gray-50">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 flex items-center">
          <span class="w-12 h-1 bg-black mr-4"></span>
          Currently Consuming
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-2xl font-bold mb-6">Reading</h3>
            <ul class="space-y-4">
              <li class="flex items-start">
                <span class="text-2xl mr-3">📖</span>
                <div>
                  <p class="font-bold">Thinking, Fast and Slow</p>
                  <p class="text-sm text-gray-600">Daniel Kahneman</p>
                </div>
              </li>
              <li class="flex items-start">
                <span class="text-2xl mr-3">📖</span>
                <div>
                  <p class="font-bold">Gödel, Escher, Bach</p>
                  <p class="text-sm text-gray-600">Douglas Hofstadter</p>
                </div>
              </li>
              <li class="flex items-start">
                <span class="text-2xl mr-3">📖</span>
                <div>
                  <p class="font-bold">The Design of Everyday Things</p>
                  <p class="text-sm text-gray-600">Don Norman</p>
                </div>
              </li>
            </ul>
          </div>

          <div>
            <h3 class="text-2xl font-bold mb-6">Learning</h3>
            <ul class="space-y-4">
              <li class="flex items-start">
                <span class="text-2xl mr-3">🎓</span>
                <div>
                  <p class="font-bold">Advanced Algorithms</p>
                  <p class="text-sm text-gray-600">MIT OpenCourseWare</p>
                </div>
              </li>
              <li class="flex items-start">
                <span class="text-2xl mr-3">🎓</span>
                <div>
                  <p class="font-bold">System Design</p>
                  <p class="text-sm text-gray-600">Various online resources</p>
                </div>
              </li>
              <li class="flex items-start">
                <span class="text-2xl mr-3">🎓</span>
                <div>
                  <p class="font-bold">Philosophy of Mind</p>
                  <p class="text-sm text-gray-600">Stanford Encyclopedia</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Fun Stats -->
    <section class="py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 flex items-center">
          <span class="w-12 h-1 bg-black mr-4"></span>
          By The Numbers
        </h2>

        <div class="grid grid-cols-2 md:grid-cols-5 gap-6 text-center">
          <div>
            <div class="text-4xl font-bold mb-2">1000+</div>
            <div class="text-gray-600">Cups of Coffee</div>
          </div>

          <div>
            <div class="text-4xl font-bold mb-2">50+</div>
            <div class="text-gray-600">Books Read</div>
          </div>

          <div>
            <div class="text-4xl font-bold mb-2">100+</div>
            <div class="text-gray-600">Poker Sessions</div>
          </div>

          <div>
            <div class="text-4xl font-bold mb-2">5K+</div>
            <div class="text-gray-600">Buckets Made</div>
          </div>

          <div>
            <div class="text-4xl font-bold mb-2">∞</div>
            <div class="text-gray-600">Things to Learn</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact CTA -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-black text-white">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Let's Connect</h2>
        <p class="text-gray-300 mb-8">
          Whether you want to talk code, poker strategy, philosophy, or anything in between.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-white text-black font-medium hover:bg-gray-100 transition-colors">
            GitHub
          </a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-white text-black font-medium hover:bg-gray-100 transition-colors">
            LinkedIn
          </a>
          <a href="mailto:your.email@example.com" class="px-6 py-3 bg-white text-black font-medium hover:bg-gray-100 transition-colors">
            Email
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
