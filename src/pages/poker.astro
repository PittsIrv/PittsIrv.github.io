---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const allGames = await getCollection('poker-games');
const learnedGames = allGames.filter(game => game.data.category === 'learned');
const myGames = allGames.filter(game => game.data.category === 'created');
---

<Layout title="Poker Games - Mingxi Yan">
  <Navigation />

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-gray-50 to-white">
      <div class="max-w-5xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-bold mb-6 opacity-0 animate-fade-in-up">Dealer's Choice</h1>
        <p class="text-xl text-gray-600 max-w-3xl opacity-0 animate-fade-in-up delay-100">
          Custom poker game variations for home games. All games are <strong>pot limit</strong> and <strong>bomb pots</strong> unless noted otherwise.
          Assumes knowledge of standard Texas Hold'em rules.
        </p>
        <div class="mt-6 opacity-0 animate-fade-in-up delay-200">
          <div class="flex flex-wrap gap-4 text-sm text-gray-600">
            <div class="flex items-center">
              <span class="w-3 h-3 bg-blue-500 rounded-full mr-2"></span>
              <span><strong>{learnedGames.length}</strong> Games I Learned</span>
            </div>
            <div class="flex items-center">
              <span class="w-3 h-3 bg-purple-500 rounded-full mr-2"></span>
              <span><strong>{myGames.length}</strong> My Creations</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Games I Learned -->
    <section class="py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 flex items-center">
          <span class="w-12 h-1 bg-blue-500 mr-4"></span>
          Games I Learned
        </h2>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {learnedGames.map((game, index) => (
            <div class="bg-white border-2 border-blue-200 p-8 hover:border-blue-500 transition-all duration-300 opacity-0 animate-fade-in-up" style={`animation-delay: ${index * 100}ms`}>
              <div class="mb-4">
                <h3 class="text-2xl font-bold mb-3">{game.data.name}</h3>
                <p class="text-sm italic text-blue-700 font-medium mb-4">"{game.data.quote}"</p>
              </div>

              <p class="text-gray-600 mb-6 leading-relaxed">{game.data.description}</p>

              <div class="border-t border-gray-200 pt-4">
                <h4 class="font-bold mb-3 text-sm uppercase tracking-wide text-gray-700">Rules</h4>
                <ul class="space-y-2">
                  {game.data.rules.map((rule, ruleIndex) => (
                    <li class="flex items-start text-sm text-gray-600">
                      <span class="flex-shrink-0 w-6 h-6 bg-blue-500 text-white rounded-full flex items-center justify-center mr-3 text-xs font-bold">
                        {ruleIndex + 1}
                      </span>
                      <span class="pt-0.5">{rule}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- My Creations -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-gray-50">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 flex items-center">
          <span class="w-12 h-1 bg-purple-500 mr-4"></span>
          My Creations
        </h2>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {myGames.map((game, index) => (
            <div class="bg-white border-2 border-purple-200 p-8 hover:border-purple-500 transition-all duration-300 opacity-0 animate-fade-in-up" style={`animation-delay: ${index * 100}ms`}>
              <div class="mb-4">
                <h3 class="text-2xl font-bold mb-3">{game.data.name}</h3>
                <p class="text-sm italic text-purple-700 font-medium mb-4">"{game.data.quote}"</p>
              </div>

              <p class="text-gray-600 mb-6 leading-relaxed">{game.data.description}</p>

              <div class="border-t border-gray-200 pt-4">
                <h4 class="font-bold mb-3 text-sm uppercase tracking-wide text-gray-700">Rules</h4>
                <ul class="space-y-2">
                  {game.data.rules.map((rule, ruleIndex) => (
                    <li class="flex items-start text-sm text-gray-600">
                      <span class="flex-shrink-0 w-6 h-6 bg-purple-500 text-white rounded-full flex items-center justify-center mr-3 text-xs font-bold">
                        {ruleIndex + 1}
                      </span>
                      <span class="pt-0.5">{rule}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Game Glossary -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 border-t border-gray-200">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl font-bold mb-8">Terminology</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
          <div class="bg-gray-50 p-4 rounded">
            <h3 class="font-bold mb-2">Bomb Pot</h3>
            <p class="text-gray-600">All players ante before cards are dealt. No pre-flop betting; action starts at the flop.</p>
          </div>
          <div class="bg-gray-50 p-4 rounded">
            <h3 class="font-bold mb-2">Pot Limit</h3>
            <p class="text-gray-600">Maximum bet/raise cannot exceed the current pot size.</p>
          </div>
          <div class="bg-gray-50 p-4 rounded">
            <h3 class="font-bold mb-2">Double Board</h3>
            <p class="text-gray-600">Two separate community card boards are dealt. Pot typically splits between winners of each board.</p>
          </div>
          <div class="bg-gray-50 p-4 rounded">
            <h3 class="font-bold mb-2">BB (Big Blind)</h3>
            <p class="text-gray-600">Standard poker betting unit. 1BB = minimum bet size for that game.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
