---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const builtThings = [
  { name: "Dealer’s Choice", href: "https://dealer-s-choice.vercel.app/", host: "dealer-s-choice.vercel.app", image: "/images/built/dealers-choice.jpg" },
  { name: "UNIFY", href: "https://unify-renew.vercel.app/", host: "unify-renew.vercel.app", image: "/images/built/unify.jpg" },
  { name: "Golfie", href: "https://golfie-beta.vercel.app/", host: "golfie-beta.vercel.app", image: "/images/built/golfie.jpg" },
];
const entries = [
  { number: '01', kind: 'Engineering · TikTok', title: 'Finding the right data is part of the problem.', text: 'An internal AI agent should be able to find a usable data source from a question. The user should not have to know the table name first.', detail: 'During my data engineering internship, I worked on data discovery for internal AI agents and a revenue-diagnosis workflow for livestream operations. Both were validated with operations and business stakeholders and adopted into their working process.', href: '/work#tiktok', link: 'What I worked on' },
  { number: '02', kind: 'Research · CMU–Apple', title: 'Who is asking changes the attack.', text: 'PersonaTeaming adds personas to automated red-teaming. I worked on how those personas are generated and evaluated the workflow across six target models.', detail: 'I am the second author on this UIST 2026 paper. I suggested persona as an additional axis, worked on the dynamic generation mechanism, implemented the workflow, and wrote the technical results section.', href: '/work#personateaming', link: 'Read about PersonaTeaming' },
  { number: '03', kind: 'Ongoing research · Sapling Lab', title: 'When does someone start treating an AI as having a mind?', text: 'I am working on a simulation study of how these beliefs form and change over a long conversation.', detail: 'The study looks at user characteristics, assistant social behavior, and conversational situation. I lead the NLP side and work on the simulation pipeline and turn-by-turn measurement. The manuscript is in preparation.', href: '/work#sapling', link: 'The ongoing study' },
];
---
<Layout title="Mingxi Yan — AI Systems Engineer" description="Mingxi Yan is a master’s student at Carnegie Mellon’s Language Technologies Institute building AI systems and the infrastructure around them: retrieval, evaluation, agents, and data.">
  <Navigation />
  <main id="main-content" class="notebook-home">
    <section class="home-intro page-shell">
      <div class="intro-copy">
        <p class="eyebrow">Carnegie Mellon <span class="ink-dot" aria-hidden="true">•</span> Language Technologies Institute</p>
        <h1>Mingxi Yan</h1>
        <div class="intro-links"><a class="text-link" href="/work">My work <span aria-hidden="true">↗</span></a><a href="/resume.pdf">Resume (PDF) ↗</a><a href="mailto:mingxiy66@gmail.com">Email ↗</a></div>
      </div>
      <aside class="margin-note">
        <span class="eyebrow">Currently</span>
        <p>Fifth-year master’s student, graduating August 2027. Looking for full-time roles in AI systems and infrastructure.</p>
        <a class="text-link" href="/about">About me ↗</a>
        <span class="margin-caption">BS, Information Systems and Computer Science<br />Carnegie Mellon, May 2026</span>
      </aside>
    </section>

    <section class="built-section page-shell" aria-labelledby="built-title">
      <p class="eyebrow" id="built-title">Live projects</p>
      <div class="built-grid">
        {builtThings.map(thing => (
          <a class="built-tile" href={thing.href} target="_blank" rel="noopener noreferrer">
            <img src={thing.image} alt={`${thing.name} start screen`} width="1200" height="750" loading="lazy" decoding="async" />
            <span class="built-caption"><strong>{thing.name}</strong><span>{thing.host} <span aria-hidden="true">↗</span></span></span>
          </a>
        ))}
      </div>
    </section>

    <section id="explore" class="explore-section page-shell" aria-labelledby="explore-title">
      <div class="section-heading"><div><p class="eyebrow">Selected work</p><h2 id="explore-title">What I’m working on</h2></div><a class="section-aside text-link" href="/personal">Poker, writing, and the rest ↗</a></div>
      <div class="note-grid">
        {entries.map(entry => (
          <details class="explore-note" id={`note-${entry.number}`}>
            <summary><span class="note-top"><span class="eyebrow">{entry.kind}</span><span class="note-number">{entry.number}</span></span><h3>{entry.title}</h3><p>{entry.text}</p><span class="note-prompt"><span class="when-closed">Open the note</span><span class="when-open">Close the note</span><span class="note-plus" aria-hidden="true">+</span></span></summary>
            <div class="note-detail"><p>{entry.detail}</p><a class="text-link" href={entry.href}>{entry.link} ↗</a></div>
          </details>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
