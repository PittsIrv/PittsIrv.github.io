---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import homeData from '../data/home.json';
import projectsData from '../data/projects.json';
import { homeSchema, projectsSchema } from '../data/schemas';
import { slug } from '../utils/slug';

const home = homeSchema.parse(homeData);
const projectData = projectsSchema.parse(projectsData);

// Project preview: the first three active public projects, in data-file order.
const preview = projectData.filter(p => p.status === 'active' && p.visibility === 'public').slice(0, 3);
---
<Layout title="Mingxi Yan — AI Systems Engineer" description="Mingxi Yan: AI systems engineer and MS student at Carnegie Mellon’s Language Technologies Institute. Retrieval, evaluation, agents, and data.">
  <Navigation />
  <main id="main-content" class="home page-shell">
    <section class="home-id">
      <div>
        <h1>Mingxi Yan</h1>
        <p class="home-affil">{home.affiliation}</p>
        <p class="home-links"><a href="/work">Work</a><a href="/meetwo">Ask MeeTwo</a><a href="/resume.pdf">Resume (PDF)</a><a href="mailto:mingxiy66@gmail.com">Email</a></p>
      </div>
      <aside class="home-now" aria-labelledby="now-title">
        <h2 id="now-title">Currently</h2>
        <p>{home.currently}</p>
        <p class="home-prev">{home.previously}</p>
        <a class="text-link" href="/about">About</a>
      </aside>
    </section>

    <section class="home-section" aria-labelledby="work-title">
      <div class="home-head"><h2 id="work-title">Selected work</h2><a class="text-link" href="/work">All work</a></div>
      {home.selectedWork.map(w => (
        <article class="home-row">
          <div>
            <h3><a href={w.href}>{w.title}</a></h3>
            <p>{w.text} {w.detail}</p>
          </div>
          <p class="home-meta">{w.kind}</p>
        </article>
      ))}
    </section>

    <section class="home-section" aria-labelledby="projects-title">
      <div class="home-head"><h2 id="projects-title">Projects</h2><a class="text-link" href="/projects">All projects</a></div>
      {preview.map(p => (
        <article class="home-row">
          <div>
            <h3><a href={`/projects#${slug(p.name)}`}>{p.name}</a></h3>
            <p>{p.oneLine}</p>
          </div>
          <ul class="home-tags" aria-label="Stack">{p.tags.map(t => <li>{t}</li>)}</ul>
        </article>
      ))}
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .home { padding-bottom: 4rem; }
  .home-id { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 2.5rem 4rem; padding-block: 4.5rem 3.5rem; border-bottom: 1px solid var(--line); }
  .home-id h1 { font-size: clamp(2.6rem, 6vw, 3.5rem); font-weight: 500; line-height: 1.05; letter-spacing: -.025em; }
  .home-affil { font-family: var(--font-serif); font-size: 1.25rem; line-height: 1.5; margin-top: .85rem; }
  .home-links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 1.5rem; font-size: 1rem; }
  .home-links a { color: var(--accent); text-decoration: underline; text-decoration-color: #a7b8e5; text-underline-offset: .3em; }
  .home-links a:hover { text-decoration-color: currentColor; }
  .home-now { align-self: start; background: var(--wash); padding: 1.4rem 1.6rem 1.5rem; display: flex; flex-direction: column; gap: .7rem; align-items: start; }
  .home-now h2 { font-family: var(--font-sans); font-size: .875rem; font-weight: 600; color: var(--muted); }
  .home-now p { font-family: var(--font-serif); font-size: 1.125rem; line-height: 1.55; }
  .home-now .home-prev { font-family: var(--font-sans); font-size: .9375rem; color: var(--muted); }
  .home-section { padding-top: 3rem; }
  .home-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: .75rem; }
  .home-head h2 { font-size: 1.75rem; font-weight: 500; letter-spacing: -.02em; }
  .home-row { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: .5rem 4rem; padding-block: 1.25rem; border-top: 1px solid var(--line); }
  .home-row h3 { font-size: 1.3rem; font-weight: 600; letter-spacing: -.01em; margin-bottom: .3rem; }
  .home-row h3 a:hover { color: var(--accent); }
  .home-row p { font-size: 1rem; line-height: 1.6; }
  .home-meta { color: var(--muted); }
  .home-tags { display: flex; flex-wrap: wrap; gap: .375rem; align-content: start; }
  .home-tags li { font-size: .8125rem; line-height: 1.4; background: var(--wash); color: var(--ink); padding: .2rem .5rem; border-radius: 3px; }
  @media (max-width: 899px) { .home-id, .home-row { grid-template-columns: 1fr; } .home-id { padding-block: 3rem 2.5rem; } }
</style>
