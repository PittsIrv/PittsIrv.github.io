---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const entries = [
  { number: '01', kind: 'Engineering · TikTok', title: 'Enterprise retrieval for AI agents', text: 'Graph-based retrieval over Hive tables, dashboards, and documents.', detail: 'Evaluated on an on-call Q&A benchmark and shipped as an internal skill. Also built a livestream revenue-diagnosis copilot now used by operations.', href: '/work#tiktok', link: 'Details' },
  { number: '02', kind: 'Research · CMU–Apple', title: 'PersonaTeaming', text: 'Persona-conditioned automated red-teaming. UIST 2026.', detail: 'Designed the persona-generation algorithm. Across 11 conditions and 6 target models: +46% attack success and +7% attack diversity over RainbowPlus.', href: '/work#personateaming', link: 'Details' },
  { number: '03', kind: 'Research · Sapling Lab', title: 'Mind attribution in human–AI conversation', text: 'Simulation study of how users attribute minds to AI over long conversations.', detail: 'NLP lead. Multi-turn user simulation and turn-level LLM judges. Manuscript in preparation.', href: '/work#sapling', link: 'Details' },
];
---
<Layout title="Mingxi Yan — AI Systems Engineer" description="Mingxi Yan: AI systems engineer and MS student at Carnegie Mellon’s Language Technologies Institute. Retrieval, evaluation, agents, and data.">
  <Navigation />
  <main id="main-content" class="notebook-home">
    <section class="home-intro page-shell">
      <div class="intro-copy">
        <p class="eyebrow">Carnegie Mellon <span class="ink-dot" aria-hidden="true">•</span> Language Technologies Institute</p>
        <h1>Mingxi Yan</h1>
        <div class="intro-links"><a class="text-link" href="/work">Work <span aria-hidden="true">↗</span></a><a href="/meetwo">Ask MeeTwo ↗</a><a href="/resume.pdf">Resume (PDF) ↗</a><a href="mailto:mingxiy66@gmail.com">Email ↗</a></div>
      </div>
      <aside class="margin-note">
        <span class="eyebrow">Currently</span>
        <p>MS student, graduating August 2027. Seeking full-time roles in AI systems and infrastructure.</p>
        <a class="text-link" href="/about">About ↗</a>
        <span class="margin-caption">BS, Computer Science and Information Systems<br />Carnegie Mellon, May 2026</span>
      </aside>
    </section>

    <section class="explore-section page-shell" aria-labelledby="projects-title">
      <div class="section-heading"><div><p class="eyebrow">Projects</p><h2 id="projects-title">All projects</h2></div><a class="section-aside text-link" href="/projects">Gallery ↗</a></div>
    </section>

    <section id="explore" class="explore-section page-shell" aria-labelledby="explore-title">
      <div class="section-heading"><div><p class="eyebrow">Research & engineering</p><h2 id="explore-title">Selected work</h2></div><a class="section-aside text-link" href="/personal">Personal ↗</a></div>
      <div class="note-grid">
        {entries.map(entry => (
          <details class="explore-note" id={`note-${entry.number}`}>
            <summary><span class="note-top"><span class="eyebrow">{entry.kind}</span><span class="note-number">{entry.number}</span></span><h3>{entry.title}</h3><p>{entry.text}</p><span class="note-prompt"><span class="when-closed">Details</span><span class="when-open">Close</span><span class="note-plus" aria-hidden="true">+</span></span></summary>
            <div class="note-detail"><p>{entry.detail}</p><a class="text-link" href={entry.href}>{entry.link} ↗</a></div>
          </details>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
