---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const allQuotes = await getCollection('quotes');
const quote = allQuotes.length
  ? allQuotes[Math.floor(Math.random() * allQuotes.length)].data
  : null;

const featured = [
  {
    href: '/work#experience',
    title: 'TikTok — Data Engineer Intern',
    blurb:
      'Led an enterprise data-discovery capability that lets internal AI agents find usable data sources from plain-language questions, and built a revenue-diagnosis workflow for livestream operations.',
  },
  {
    href: '/work#publications',
    title: 'PersonaTeaming — CMU–Apple, UIST 2026',
    blurb:
      'Second author. Proposed persona as an additional axis for automated red-teaming, designed the dynamic persona-generation mechanism, and ran the evaluation across six target models.',
  },
  {
    href: '/work#publications',
    title: 'Teaching a model to explain poker',
    blurb:
      'Fine-tuned Llama 3 8B to produce both a solver-backed action and an explanation for it, then built a rule-based verifier and validated it against 200 blind human judgments.',
  },
];
---

<Layout
  title="Mingxi Yan"
  description="Mingxi Yan — AI systems engineer and CMU Language Technologies master's student. Experience at TikTok, CMU Chimps Lab (CMU–Apple), and CMU Sapling Lab."
>
  <Navigation />

  <main class="flex-grow">
    <!-- Positioning -->
    <section class="pt-20 pb-14 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-semibold tracking-tight mb-6 opacity-0 animate-fade-in-up">
          Mingxi Yan
        </h1>

        <p class="text-xl md:text-2xl text-gray-800 max-w-2xl leading-snug font-serif opacity-0 animate-fade-in-up delay-100">
          I build AI systems and the infrastructure around them — retrieval, evaluation,
          data pipelines, and the services that put models in front of real users.
        </p>

        <p class="mt-6 text-gray-600 max-w-2xl leading-relaxed opacity-0 animate-fade-in-up delay-200">
          Carnegie Mellon University — fifth-year master's at the Language Technologies Institute,
          expected August 2027. Previously Data Engineer Intern at TikTok, and second author on
          PersonaTeaming, a CMU–Apple collaboration at UIST 2026.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm opacity-0 animate-fade-in-up delay-300">
          <a href="/work" class="font-medium px-5 py-2.5 bg-black text-white hover:bg-gray-800 transition-colors">
            See my work
          </a>
          <a href="/resume.pdf" class="font-medium border-b border-black hover:text-gray-600 hover:border-gray-600 transition-colors">Resume (PDF)</a>
          <a href="https://github.com/PittsIrv" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-black transition-colors">GitHub</a>
          <a href="https://www.linkedin.com/in/mingxi-yan-0b9581272" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-black transition-colors">LinkedIn</a>
          <a href="mailto:mingxiy66@gmail.com" class="text-gray-600 hover:text-black transition-colors">Email</a>
        </div>
      </div>
    </section>

    <!-- Featured work -->
    <section class="py-14 px-4 sm:px-6 lg:px-8 bg-gray-50 border-y border-gray-200">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-sm font-sans font-semibold uppercase tracking-[0.15em] text-gray-500 mb-8">Selected work</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {featured.map(item => (
            <a href={item.href} class="group border-t border-gray-300 pt-5">
              <h3 class="text-lg font-semibold mb-2 group-hover:text-gray-600 transition-colors">{item.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{item.blurb}</p>
              <span class="inline-block mt-3 text-sm text-gray-500 group-hover:text-black transition-colors">Read more →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Through-line -->
    <section class="py-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto">
        <div class="space-y-5 text-gray-700 leading-[1.75] font-serif text-[1.0625rem]">
          <p>
            I came to code late — only after starting university — which means I still remember what
            it feels like not to understand it.
          </p>
          <p>
            Outside of work I invent poker games. Then I built a platform so my friends and I could
            actually play them, and later spent a semester teaching a language model to explain poker
            decisions rather than just make them. It turns out that's the same instinct every time:
            find the system underneath, then make it explain itself.
          </p>
          <p>
            I also write — poems, essays, fragments — mostly to find out what I think.
            That, and the poker rules, live <a href="/personal" class="border-b border-gray-400 hover:border-black transition-colors">on the personal side</a> of this site.
          </p>
        </div>
      </div>
    </section>

    <!-- Quote -->
    {quote && (
      <section class="py-16 px-4 sm:px-6 lg:px-8 border-t border-gray-200">
        <div class="max-w-2xl mx-auto text-center">
          <blockquote class="text-xl md:text-2xl font-serif italic text-gray-700 leading-relaxed">
            "{quote.text}"
          </blockquote>
          <p class="mt-5 text-sm text-gray-500">— {quote.author}</p>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>
