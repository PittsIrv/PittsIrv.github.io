---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

// Load poems, articles, and quotes from content collections
const allPoems = await getCollection('poems');
const allArticles = await getCollection('articles');
const allQuotes = await getCollection('quotes');

// Filter out drafts and sort
const poems = allPoems
  .filter(poem => !poem.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map(poem => {
    // Get excerpt from content (first 4 non-empty lines to show poem structure)
    const allLines = poem.body.split('\n');
    const nonEmptyLines = allLines.filter(line => line.trim().length > 0);
    const excerpt = nonEmptyLines.slice(0, 4).join('\n');

    return {
      title: poem.data.title,
      date: poem.data.date,
      category: poem.data.category,
      excerpt,
      slug: poem.slug
    };
  });

const articles = allArticles
  .filter(article => !article.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map(article => {
    // Get excerpt from content (first paragraph)
    const paragraphs = article.body.split('\n\n').filter(p => p.trim());
    const excerpt = paragraphs[0] || '';

    return {
      title: article.data.title,
      date: article.data.date,
      readTime: article.data.readTime,
      excerpt,
      tags: article.data.tags,
      slug: article.slug
    };
  });

// Randomly select 6 quotes to display
const shuffleArray = (array) => {
  const shuffled = [...array];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  return shuffled;
};

const quotes = shuffleArray(allQuotes)
  .slice(0, 6)
  .map(quote => ({
    text: quote.data.text,
    author: quote.data.author
  }));
---

<Layout title="Writing - Mingxi Yan">
  <Navigation />

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-gray-50 to-white">
      <div class="max-w-5xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-bold mb-6 opacity-0 animate-fade-in-up">Writing</h1>
        <p class="text-xl text-gray-600 max-w-3xl opacity-0 animate-fade-in-up delay-100">
          Poetry, articles, philosophical musings, and collected wisdom from minds greater than mine.
        </p>

        <!-- Category Filter -->
        <div class="mt-8 flex flex-wrap gap-3 opacity-0 animate-fade-in-up delay-200">
          <button class="category-btn px-4 py-2 bg-black text-white font-medium text-sm transition-all" data-category="all">
            All
          </button>
          <button class="category-btn px-4 py-2 bg-gray-200 text-gray-700 font-medium text-sm hover:bg-gray-300 transition-all" data-category="poems">
            Poems
          </button>
          <button class="category-btn px-4 py-2 bg-gray-200 text-gray-700 font-medium text-sm hover:bg-gray-300 transition-all" data-category="articles">
            Articles
          </button>
          <button class="category-btn px-4 py-2 bg-gray-200 text-gray-700 font-medium text-sm hover:bg-gray-300 transition-all" data-category="quotes">
            Quotes
          </button>
        </div>
      </div>
    </section>

    <!-- Poems Section -->
    <section class="content-section py-16 px-4 sm:px-6 lg:px-8" data-category="poems">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 flex items-center">
          <span class="w-12 h-1 bg-black mr-4"></span>
          Poems
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {poems.map((poem) => (
            <div class="bg-white border border-gray-200 p-6 hover:shadow-lg transition-all duration-300 group">
              <div class="mb-4">
                <span class="text-xs font-medium text-gray-500 uppercase tracking-wide">{poem.category}</span>
                <h3 class="text-xl font-bold mt-2 mb-3 group-hover:text-gray-600 transition-colors">
                  {poem.title}
                </h3>
                <p class="text-sm text-gray-500 mb-4">{poem.date}</p>
              </div>

              <p class="text-gray-600 italic leading-relaxed whitespace-pre-line">
                {poem.excerpt}
              </p>

              <div class="mt-4 pt-4 border-t border-gray-200">
                <a href={`/poems/${poem.slug}`} class="text-sm font-medium hover:underline">Read full poem →</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Articles Section -->
    <section class="content-section py-16 px-4 sm:px-6 lg:px-8 bg-gray-50" data-category="articles">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 flex items-center">
          <span class="w-12 h-1 bg-black mr-4"></span>
          Articles
        </h2>

        <div class="space-y-8">
          {articles.map((article) => (
            <article class="bg-white p-8 hover:shadow-lg transition-all duration-300 group">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between mb-4">
                <div class="flex-1">
                  <h3 class="text-2xl font-bold mb-2 group-hover:text-gray-600 transition-colors">
                    {article.title}
                  </h3>
                  <div class="flex items-center text-sm text-gray-500 space-x-4 mb-4">
                    <span>{article.date}</span>
                    <span>•</span>
                    <span>{article.readTime} read</span>
                  </div>
                </div>
              </div>

              <p class="text-gray-600 leading-relaxed mb-4">
                {article.excerpt}
              </p>

              <div class="flex flex-wrap gap-2 mb-4">
                {article.tags.map((tag) => (
                  <span class="px-3 py-1 bg-gray-100 text-gray-700 text-xs font-medium">{tag}</span>
                ))}
              </div>
              <a href={`/articles/${article.slug}`} class="text-sm font-medium hover:underline">Read more →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Quotes Section -->
    <section class="content-section py-16 px-4 sm:px-6 lg:px-8" data-category="quotes">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 flex items-center">
          <span class="w-12 h-1 bg-black mr-4"></span>
          Favorite Quotes
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {quotes.map((quote, index) => (
            <div class="bg-white border-l-4 border-black p-6 hover:shadow-lg transition-all duration-300" style={`animation-delay: ${index * 100}ms`}>
              <blockquote class="text-lg font-serif italic text-gray-700 mb-4 leading-relaxed">
                "{quote.text}"
              </blockquote>
              <p class="text-sm text-gray-500 font-medium">— {quote.author}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Philosophy Section -->
    <section class="content-section py-16 px-4 sm:px-6 lg:px-8 bg-gray-50" data-category="all">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 flex items-center">
          <span class="w-12 h-1 bg-black mr-4"></span>
          Philosophical Musings
        </h2>

        <div class="space-y-8">
          <div class="bg-white p-8">
            <h3 class="text-2xl font-bold mb-4">On Freedom and Responsibility</h3>
            <div class="prose prose-gray max-w-none text-gray-600 leading-relaxed space-y-4">
              <p>
                Perhaps we are not free. Perhaps every choice is predetermined by the firing of neurons, the chemistry
                of our brains, the circumstances of our birth. Perhaps free will is an elaborate illusion our minds
                construct to make sense of a deterministic universe.
              </p>
              <p>
                And yet, Kant teaches us that we must act as if we are free. When we stand at a crossroads, we cannot
                wait for neuroscience to settle the question of determinism. We must choose. We must deliberate. We must
                take responsibility for our actions as if they truly originated from us.
              </p>
              <p>
                This is the beautiful paradox: even if freedom is an illusion, it is a necessary one. To be moral, to be
                human, to make any decision at all, we must assume our freedom. The question is not whether we are truly
                free, but whether we have the courage to act as if we are.
              </p>
            </div>
          </div>

          <div class="bg-white p-8">
            <h3 class="text-2xl font-bold mb-4">On Uncertainty</h3>
            <div class="prose prose-gray max-w-none text-gray-600 leading-relaxed space-y-4">
              <p>
                At the poker table, uncertainty is not an obstacle but rather the game itself. You cannot see your opponent's
                cards. You cannot know which river card will fall. You calculate odds, read tells, and make the best
                decision you can with incomplete information. Then you accept the result, whatever it may be.
              </p>
              <p>
                Heidegger speaks of being-toward-death, the idea that authentic existence requires confronting our own
                mortality. Death is the ultimate uncertainty, the one certainty we cannot escape but whose timing and
                manner remain unknown. Every decision we make is made in its shadow.
              </p>
              <p>
                Perhaps this is why poker feels so honest. It strips away the illusion that we can control outcomes. It
                teaches us to make peace with uncertainty, to act decisively while acknowledging our limitations. In poker,
                as in life, we are always playing with incomplete information. The wisdom is not in eliminating uncertainty,
                which is impossible, but in learning to dance with it, to make our choices and let go of the rest.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-black text-white">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Want to discuss ideas?</h2>
        <p class="text-gray-300 mb-8">
          I'm always interested in conversations about technology, philosophy, game theory, and creative writing.
        </p>
        <a href="mailto:mingxiy66@gmail.com" class="inline-block px-8 py-3 bg-white text-black font-medium hover:bg-gray-100 transition-colors">
          Get in touch
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // Category filter functionality
  const categoryBtns = document.querySelectorAll('.category-btn');
  const contentSections = document.querySelectorAll('.content-section');

  categoryBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const category = btn.getAttribute('data-category');

      // Update button states
      categoryBtns.forEach(b => {
        if (b === btn) {
          b.classList.remove('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
          b.classList.add('bg-black', 'text-white');
        } else {
          b.classList.remove('bg-black', 'text-white');
          b.classList.add('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
        }
      });

      // Show/hide sections
      contentSections.forEach(section => {
        const sectionCategory = section.getAttribute('data-category');
        if (category === 'all' || sectionCategory === category || sectionCategory === 'all') {
          section.classList.remove('hidden');
        } else {
          section.classList.add('hidden');
        }
      });
    });
  });

</script>
