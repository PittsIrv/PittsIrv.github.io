---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const education = [
  {
    degree: 'MS in Language Technologies (Artificial Intelligence)',
    school: 'Carnegie Mellon University, Pittsburgh, PA',
    dates: 'Expected August 2027',
    notes: [],
    courseLabel: 'Current coursework',
    courses:
      'Search Engines (11-642), AI Agents (11-768), Multimodal Machine Learning (11-777), Introduction to Research in Language Technologies (11-705), Directed Research (11-910)',
  },
  {
    degree: 'BS in Computer Science and Information Systems',
    school: 'Carnegie Mellon University, Pittsburgh, PA',
    dates: 'May 2026',
    notes: ['Minor in Logic and Computation', 'GPA: 3.86/4.0'],
    courseLabel: 'Selected coursework',
    courses:
      'Machine Learning (10-301), Generative AI (10-423), Natural Language Processing (11-411), Algorithm Design and Analysis (15-451), Distributed Systems (15-440), Introduction to Computer Systems (15-213), Parallel and Sequential Algorithms (15-210), Bug Catching: Automated Program Verification (15-414), Foundations of Software Engineering (17-313), Database Design and Development (67-262), Probability and Statistical Inference I–II (36-235/236), Game Theory (80-305)',
  },
];

const experience = [
  {
    role: 'Data Engineer Intern',
    org: 'TikTok, San Jose',
    id: 'tiktok',
    dates: 'June – August 2026',
    lead: 'Enterprise retrieval for internal AI agents; livestream revenue-diagnosis copilot.',
    bullets: [
      'Designed a graph-based enterprise retrieval skill over Hive tables, datasets, dashboards, documents, and millions of metadata fields and values, using query decomposition, contextual rewriting, graph expansion, and reciprocal rank fusion (RRF).',
      'Built a benchmark from on-call Q&A pairs to evaluate agent results. The skill was integrated and published as an internal skill.',
      'Built a livestream revenue-diagnosis copilot: LightGBM percentile prediction, comparison cohorts, and business rules flag revenue drops and abnormal metrics; retrieved business documentation grounds the recommendations.',
      'Validated with operations stakeholders and integrated into their workflow.',
    ],
    tags: ['Python', 'SQL', 'Graph retrieval', 'Query rewriting', 'RRF', 'LightGBM', 'Feature engineering', 'LLM agents'],
  },
  {
    role: 'Research Assistant — NLP lead',
    org: 'Sapling Lab, CMU',
    id: 'sapling',
    dates: 'May 2026 – Present',
    lead: 'Theory-of-Mind attribution toward AI in long-term interaction.',
    bullets: [
      'Lead NLP research on an NSF- and OpenAI-funded interdisciplinary project.',
      'Developing a multi-turn user simulation that varies user traits, assistant social behavior, memory, and scenario.',
      'Developing turn-level LLM judges and heuristic measures to evaluate how attributions change across a conversation. Manuscript in preparation.',
    ],
    tags: ['User simulation', 'Multi-turn evaluation', 'LLM-as-judge', 'Measurement design', 'Python'],
  },
  {
    role: 'Research Assistant',
    org: 'Chimps Lab, CMU',
    dates: 'May 2024 – May 2026',
    lead: 'LLM red-teaming and image-generation bias auditing.',
    bullets: [
      'PersonaTeaming (UIST 2026, with Apple Research): designed the persona-generation algorithm for adaptive LLM red-teaming.',
      'Evaluated 11 experimental conditions on 6 target LLMs. Improved mean attack success rate by 46% and attack diversity by 7% over the RainbowPlus baseline.',
      'Built and deployed the PersonaTeaming Playground on AWS, used in an industry practitioner study.',
      'Built bias-auditing infrastructure for image generation: persistent history, caching, and batching at 100 images per prompt, with interactive visualizations.',
    ],
    tags: ['Python', 'React', 'AWS', 'LLM red-teaming', 'Evaluation pipelines', 'LLM-as-judge', 'AI safety'],
  },
  {
    role: 'Full Stack Engineer & Tech Lead',
    org: 'Enterview (AI startup), Pittsburgh, PA',
    dates: 'June 2023 – November 2024',
    lead: 'AI interview-preparation platform.',
    bullets: [
      'Led a team of four engineers; owned technical product decisions.',
      'Designed user-context data models and backend APIs, integrating an LLM and speech recognition to evaluate spoken answers.',
      'Reduced feedback latency by optimizing WebSocket handling.',
    ],
    tags: ['TypeScript', 'Backend APIs', 'Data modeling', 'Speech recognition', 'WebSocket'],
  },
  {
    role: 'Software Engineer Intern',
    compact: true,
    org: 'AlpSoft, Singapore',
    dates: 'May 2025 – August 2025',
    lead: 'Enterprise sites for EnterpriseSG; penetration-test fixes and AWS deployments.',
    bullets: [],
    tags: [],
  },
  {
    role: 'Research Intern',
    compact: true,
    org: 'Tsinghua University, THUNLP — OpenBMB',
    dates: 'May 2023 – August 2023',
    lead: 'REST APIs as LLM-callable tools; embedding-based clustering for tool retrieval.',
    bullets: [],
    tags: [],
  },
  {
    role: 'Teaching Assistant',
    compact: true,
    org: 'CMU — Great Ideas in Theoretical Computer Science (15-251)',
    dates: 'February – May 2025',
    lead: 'Proof and theory tutoring; study guides and exam reviews.',
    bullets: [],
    tags: [],
  },
  {
    role: 'IS Consulting Project',
    compact: true,
    org: 'ProtectPT (Non-Profit), Pittsburgh, PA',
    dates: 'Spring 2024',
    lead: 'Searchable database for a local anti-fracking non-profit.',
    bullets: [],
    tags: [],
  },
];

const projects = [
  {
    name: 'standin',
    dates: 'October 2026 – Present',
    lead: 'Open-source personal agent that answers as you and discloses only approved information.',
    link: { href: 'https://github.com/PittsIrv/standin', label: 'github.com/PittsIrv/standin' },
    image: null,
    bullets: [
      'Local store of sourced, bitemporal memories, including explicit unknowns.',
      'Default-deny airlock: only approved, versioned, reversible bundles reach the public agent.',
      'Hybrid retrieval (keyword search and local embeddings, fused with RRF); eval harness that fails on any leak.',
    ],
    tags: ['TypeScript', 'SQLite', 'Claude API', 'Hybrid retrieval', 'Evals', 'Privacy'],
  },
  {
    name: 'Golfie',
    dates: 'January 2026 – Present',
    lead: 'Golf swing analysis from phone video: fault detection, drills, and coach review.',
    link: { href: 'https://golfie-beta.vercel.app/', label: 'golfie-beta.vercel.app' },
    image: { src: '/images/built/golfie.jpg', alt: 'Golfie start screen with a sample swing analysis', width: 1200, height: 750 },
    bullets: [
      'Three-phase pipeline: pose estimation, rule-based fault detection across five swing phases, LLM-generated drill plan.',
      'Per-video pose tiers, from RTMPose on CPU to GPU models on Modal.',
      'Coarse pass to locate the swing, then a dense pass at native frame rate to capture impact.',
    ],
    tags: ['Python', 'FastAPI', 'Next.js', 'TypeScript', 'RTMPose', 'ONNX Runtime', 'Modal', 'Docker'],
  },
  {
    name: 'Daybook',
    dates: 'October 2026 – Present',
    lead: 'Local-only weekly review of Mac Screen Time.',
    link: { href: 'https://github.com/PittsIrv/daybook', label: 'github.com/PittsIrv/daybook' },
    image: { src: '/images/built/daybook.jpg', alt: 'Daybook weekly review, shown with fictional demo data', width: 1280, height: 720 },
    bullets: [],
    tags: [],
  },
  {
    name: 'Dealer’s Choice',
    dates: 'June 2025 – Present',
    lead: 'Online multiplayer platform for home-game poker variants.',
    link: { href: 'https://dealer-s-choice.vercel.app/', label: 'dealer-s-choice.vercel.app' },
    image: { src: '/images/built/dealers-choice.jpg', alt: 'Dealer’s Choice start screen', width: 1200, height: 750 },
    bullets: [
      'Custom variants with real-time multiplayer over WebSocket.',
      'ECS in private subnets behind a public ALB; CI/CD for testing and deployment.',
    ],
    rulesLink: true,
    tags: ['TypeScript', 'NestJS', 'WebSocket', 'AWS ECS', 'Docker', 'CI/CD'],
  },
  {
    name: 'Brawl Lab',
    dates: 'October 2026 – Present',
    lead: 'Brawl Stars final-pick recommender. Calibrated logistic regression trained on about 400,000 Ranked sets.',
    link: null,
    image: { src: '/images/built/brawl-lab.jpg', alt: 'Brawl Lab final-pick interface', width: 1280, height: 720 },
    bullets: [],
    tags: [],
  },
  {
    name: 'Table Forty Nine',
    dates: 'October 2026 – Present',
    lead: '1v1 online poker card battler. In design.',
    link: null,
    image: null,
    bullets: [],
    tags: [],
  },
];

const publications = [
  {
    title: 'PersonaTeaming: Persona-Conditioned Automated Red Teaming',
    id: 'personateaming',
    meta: 'UIST 2026 · CMU–Apple collaboration',
    lead: 'Persona-conditioned automated red-teaming.',
    body: `Conditions adversarial prompt mutation on personas, including a dynamic method that generates and scores candidate personas. Designed the persona-generation algorithm, implemented the workflow, and ran the evaluation: 11 conditions, 6 target LLMs. Over RainbowPlus: +46% mean attack success rate, +7% attack diversity.`,
    link: null,
  },
  {
    title: 'Solver-Guided Fine-Tuning for Accurate and Explainable Poker Decisions',
    id: 'poker-paper',
    meta: '10-423/623 Generative AI, Spring 2026 · with Cassandra Shi & Harry Huang',
    lead: 'Solver-guided post-training of an 8B model for accurate, explainable poker decisions.',
    body: `Llama 3 8B trained on 3,000 SFT examples and 2,534 DPO pairs from PokerBench solver labels and verifier-ranked Llama 3.3 70B explanations; rule-based verifier validated against 200 blind human judgments. LoRA SFT: solver-action match 18.0% → 56.2%, verifier score 0.426 → 0.645. DPO improved explanations at a small cost to action accuracy.`,
    link: { href: '/papers/solver-guided-poker-finetuning.pdf', label: 'Read the paper (PDF)' },
  },
  {
    title: 'Mutual Theory of Mind in Multi-Turn Human–AI Conversation',
    meta: 'Manuscript in preparation',
    lead: 'Turn-by-turn mind attribution in multi-turn human–AI conversation.',
    body: `Multi-turn user simulation varying user traits, assistant social behavior, memory, and scenario; measured with turn-level LLM judges and heuristic measures. Sapling Lab.`,
    link: null,
  },
];

const skills = [
  { group: 'Programming', items: ['Python', 'SQL', 'C', 'JavaScript', 'TypeScript', 'Data structures', 'Database design', 'Distributed systems'] },
  { group: 'Machine learning', items: ['PyTorch', 'vLLM', 'Hugging Face', 'TRL', 'PEFT / LoRA', 'SFT', 'DPO', 'Transformers', 'Multimodal ML'] },
  { group: 'Agents', items: ['Agentic RAG', 'Agentic search', 'Tool use', 'LLM evaluation', 'Skills', 'MCP', 'Context management'] },
  { group: 'Data', items: ['PostgreSQL', 'SQLite', 'Feature engineering', 'Data pipelines', 'Information retrieval', 'Heuristic search'] },
  { group: 'Backend & infrastructure', items: ['FastAPI', 'NestJS', 'REST APIs', 'WebSocket', 'Docker', 'AWS (EC2, ECS)', 'Terraform', 'CI/CD'] },
];
---

<Layout
  title="Work - Mingxi Yan"
  description="Mingxi Yan: experience, projects, and publications in AI systems. TikTok, CMU Sapling Lab, CMU Chimps Lab."
>
  <Navigation />

  <main id="main-content" class="flex-grow">
    <!-- Header -->
    <section class="pt-16 pb-10 px-4 sm:px-6 lg:px-8 border-b border-gray-200">
      <div class="max-w-5xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-semibold tracking-tight mb-5 opacity-0 animate-fade-in-up">Work</h1>
        <p class="text-lg text-gray-700 max-w-2xl leading-relaxed opacity-0 animate-fade-in-up delay-100 font-serif">
          AI systems and infrastructure: retrieval, evaluation, agents, and data pipelines.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm opacity-0 animate-fade-in-up delay-200">
          <a href="/resume.pdf" class="font-medium border-b border-black hover:text-gray-600 hover:border-gray-600 transition-colors">Resume (PDF)</a>
          <a href="https://github.com/PittsIrv" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-black transition-colors">GitHub</a>
          <a href="https://www.linkedin.com/in/mingxi-yan-0b9581272" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-black transition-colors">LinkedIn</a>
          <a href="mailto:mingxiy66@gmail.com" class="text-gray-600 hover:text-black transition-colors">Email</a>
        </div>
        <nav class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-500 opacity-0 animate-fade-in-up delay-300">
          <a href="#experience" class="hover:text-black transition-colors">Experience</a>
          <a href="#projects" class="hover:text-black transition-colors">Projects</a>
          <a href="#publications" class="hover:text-black transition-colors">Publications</a>
          <a href="#education" class="hover:text-black transition-colors">Education</a>
          <a href="#skills" class="hover:text-black transition-colors">Skills</a>
        </nav>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="py-14 px-4 sm:px-6 lg:px-8 bg-gray-50 border-y border-gray-200 scroll-mt-16">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-sm font-sans font-semibold uppercase tracking-[0.15em] text-gray-500 mb-8">Experience</h2>
        <div class="space-y-10">
          {experience.filter(job => !job.compact).map(job => (
            <div id={job.id} class="border-t border-gray-300 pt-6">
              <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1 mb-2">
                <div>
                  <h3 class="text-xl font-semibold">{job.role}</h3>
                  <p class="text-gray-700">{job.org}</p>
                </div>
                <span class="text-sm text-gray-500 shrink-0 md:ml-6">{job.dates}</span>
              </div>
              <p class="text-gray-700 leading-relaxed max-w-3xl font-serif text-[1.0625rem]">{job.lead}</p>
              <details class="disclosure mt-4">
                <summary>
                  <span class="disclosure-closed">Details</span>
                  <span class="disclosure-open">Close</span>
                </summary>
                <div class="disclosure-body pt-4">
                  <ul class="space-y-2 text-gray-700 leading-relaxed">
                    {job.bullets.map(b => (
                      <li class="flex">
                        <span class="text-gray-400 mr-3 shrink-0">—</span>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="flex flex-wrap gap-x-3 gap-y-1 mt-4 text-xs text-gray-500">
                    {job.tags.map(tag => <span>{tag}</span>)}
                  </div>
                </div>
              </details>
            </div>
          ))}
        </div>
        <div class="border-t border-gray-300 pt-6 mt-10">
          <h3 class="text-base font-semibold mb-4">Also</h3>
          <ul class="space-y-3">
            {experience.filter(job => job.compact).map(job => (
              <li class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1">
                <span class="text-gray-700"><span class="font-medium text-black">{job.role}</span> · {job.org}. {job.lead}</span>
                <span class="text-sm text-gray-500 shrink-0 md:ml-6">{job.dates}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="py-14 px-4 sm:px-6 lg:px-8 scroll-mt-16">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-sm font-sans font-semibold uppercase tracking-[0.15em] text-gray-500 mb-8">Projects</h2>
        <div class="space-y-10">
          {projects.map(project => (
            <div class="border-t border-gray-300 pt-6 max-w-3xl">
              <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1 mb-2">
                <h3 class="text-xl font-semibold">{project.name}</h3>
                <span class="text-sm text-gray-500 shrink-0 md:ml-6">{project.dates}</span>
              </div>
              <p class="text-gray-700 leading-relaxed font-serif text-[1.0625rem]">{project.lead}</p>
              {project.link && <p class="mt-2 text-sm"><a href={project.link.href} target="_blank" rel="noopener noreferrer" class="border-b border-gray-400 hover:border-black transition-colors">{project.link.label} ↗</a></p>}
              {project.image && <img src={project.image.src} alt={project.image.alt} width={project.image.width} height={project.image.height} loading="lazy" decoding="async" class="mt-5 w-full h-auto border border-gray-200" />}
              {project.bullets.length > 0 && <details class="disclosure mt-4">
                <summary>
                  <span class="disclosure-closed">Details</span>
                  <span class="disclosure-open">Close</span>
                </summary>
                <div class="disclosure-body pt-4">
                  <ul class="space-y-2 text-gray-700 leading-relaxed">
                    {project.bullets.map(b => <li class="flex"><span class="text-gray-400 mr-3 shrink-0">—</span><span>{b}</span></li>)}
                    {project.rulesLink && <li class="flex"><span class="text-gray-400 mr-3 shrink-0">—</span><span>Variant rules: <a href="/personal#poker" class="border-b border-gray-400 hover:border-black transition-colors">Personal</a>.</span></li>}
                  </ul>
                  <div class="flex flex-wrap gap-x-3 gap-y-1 mt-4 text-xs text-gray-500">
                    {project.tags.map(tag => <span>{tag}</span>)}
                  </div>
                </div>
              </details>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Publications -->
    <section id="publications" class="py-14 px-4 sm:px-6 lg:px-8 bg-gray-50 border-y border-gray-200 scroll-mt-16">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-sm font-sans font-semibold uppercase tracking-[0.15em] text-gray-500 mb-8">Publications</h2>
        <div class="space-y-10 max-w-3xl">
          {publications.map(pub => (
            <div id={pub.id} class="border-t border-gray-300 pt-6">
              <h3 class="text-xl font-semibold mb-1">{pub.title}</h3>
              <p class="text-sm text-gray-500 mb-2">{pub.meta}</p>
              <p class="text-gray-700 leading-relaxed font-serif text-[1.0625rem]">{pub.lead}</p>
              <details class="disclosure mt-4">
                <summary>
                  <span class="disclosure-closed">Details</span>
                  <span class="disclosure-open">Close</span>
                </summary>
                <div class="disclosure-body pt-4">
                  <p class="text-gray-700 leading-relaxed">{pub.body}</p>
                  {pub.link && (
                    <a href={pub.link.href} target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-sm font-medium border-b border-black hover:text-gray-600 hover:border-gray-600 transition-colors">
                      {pub.link.label}
                    </a>
                  )}
                </div>
              </details>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Education -->
    <section id="education" class="py-14 px-4 sm:px-6 lg:px-8 scroll-mt-16">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-sm font-sans font-semibold uppercase tracking-[0.15em] text-gray-500 mb-8">Education</h2>
        <div class="space-y-10">
          {education.map(item => (
            <div>
              <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1 mb-1">
                <h3 class="text-xl font-semibold">{item.degree}</h3>
                <span class="text-sm text-gray-500 shrink-0 md:ml-6">{item.dates}</span>
              </div>
              <p class="text-gray-700">{item.school}</p>
              {item.notes.map(note => <p class="text-gray-600 text-sm mt-1">{note}</p>)}
              <details class="disclosure mt-3">
                <summary>
                  <span class="disclosure-closed">{item.courseLabel}</span>
                  <span class="disclosure-open">Close</span>
                </summary>
                <div class="disclosure-body pt-3">
                  <p class="text-sm text-gray-600 leading-relaxed">{item.courses}</p>
                </div>
              </details>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="py-14 px-4 sm:px-6 lg:px-8 bg-gray-50 border-y border-gray-200 scroll-mt-16">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-sm font-sans font-semibold uppercase tracking-[0.15em] text-gray-500 mb-8">Skills</h2>
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-7">
          {skills.map(s => (
            <div class="border-t border-gray-300 pt-4">
              <dt class="font-semibold mb-2">{s.group}</dt>
              <dd class="text-gray-600 leading-relaxed">{s.items.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
