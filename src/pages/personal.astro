---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const allGames = await getCollection('poker-games');
const learnedGames = allGames.filter(game => game.data.category === 'learned');
const myGames = allGames.filter(game => game.data.category === 'created');

const allPoems = await getCollection('poems');
const allArticles = await getCollection('articles');
const allQuotes = await getCollection('quotes');

const poems = allPoems
  .filter(poem => !poem.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map(poem => {
    const nonEmptyLines = poem.body.split('\n').filter(line => line.trim().length > 0);
    return {
      title: poem.data.title,
      date: poem.data.date,
      category: poem.data.category,
      excerpt: nonEmptyLines.slice(0, 4).join('\n'),
      slug: poem.slug,
    };
  });

const articles = allArticles
  .filter(article => !article.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map(article => {
    const paragraphs = article.body.split('\n\n').filter(p => p.trim());
    return {
      title: article.data.title,
      date: article.data.date,
      readTime: article.data.readTime,
      excerpt: paragraphs[0] || '',
      tags: article.data.tags,
      slug: article.slug,
    };
  });

const shuffleArray = (array) => {
  const shuffled = [...array];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  return shuffled;
};

const quotes = shuffleArray(allQuotes)
  .slice(0, 6)
  .map(quote => ({ text: quote.data.text, author: quote.data.author }));

// Update this by hand every couple of months — the date is the honesty mechanism.
const nowUpdated = 'October 2026';
const now = [
  { label: 'Building', text: 'standin, Golfie, Daybook, Brawl Lab, Table Forty Nine; mind-attribution research.' },
  { label: 'Learning', text: 'Search Engines, AI Agents, Multimodal Machine Learning.' },
  { label: 'Reading', text: 'The Unbearable Lightness of Being (Kundera), Ludwig Wittgenstein: The Duty of Genius (Monk), The Order of Time (Rovelli).' },
  { label: 'Playing', text: 'Basketball, Poker, Games.' },
];

const interests = ['Guitar & songwriting', 'Photography', 'Storytelling'];

const sports = [
  { name: 'Basketball', level: 'Good' },
  { name: 'Ping Pong', level: 'Good' },
  { name: 'Pool', level: 'Med' },
  { name: 'Frisbee', level: 'Med' },
  { name: 'Badminton', level: 'Med' },
  { name: 'Volleyball', level: 'Low' },
  { name: 'Football', level: 'Low' },
  { name: 'Tennis', level: 'Low' },
  { name: 'Soccer', level: 'Low' },
  { name: 'Golf', level: 'Low' },
  { name: 'Climbing', level: 'Low' },
];
---

<Layout
  title="Personal - Mingxi Yan"
  description="Mingxi Yan: poker variants, writing, quotes, and current activities."
>
  <Navigation />

  <main id="main-content" class="flex-grow">
    <!-- Header -->
    <section class="pt-16 pb-10 px-4 sm:px-6 lg:px-8 border-b border-gray-200">
      <div class="max-w-5xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-semibold tracking-tight mb-5 opacity-0 animate-fade-in-up">Personal</h1>
        <p class="text-lg text-gray-700 max-w-2xl leading-relaxed font-serif opacity-0 animate-fade-in-up delay-100">
          Poker variants, writing, and current activities.
        </p>
        <nav class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-500 opacity-0 animate-fade-in-up delay-200">
          <a href="#now" class="hover:text-black transition-colors">Now</a>
          <a href="#poker" class="hover:text-black transition-colors">Poker</a>
          <a href="#writing" class="hover:text-black transition-colors">Writing</a>
          <a href="#quotes" class="hover:text-black transition-colors">Quotes</a>
          <a href="#elsewhere" class="hover:text-black transition-colors">Elsewhere</a>
        </nav>
      </div>
    </section>

    <!-- Now -->
    <section id="now" class="py-14 px-4 sm:px-6 lg:px-8 scroll-mt-16">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-baseline justify-between mb-8">
          <h2 class="text-sm font-sans font-semibold uppercase tracking-[0.15em] text-gray-500">Now</h2>
          <span class="text-sm text-gray-400">Updated {nowUpdated}</span>
        </div>
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-7 max-w-4xl">
          {now.map(item => (
            <div class="border-t border-gray-300 pt-4">
              <dt class="font-semibold mb-2">{item.label}</dt>
              <dd class="text-gray-600 leading-relaxed">{item.text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Poker -->
    <section id="poker" class="py-14 px-4 sm:px-6 lg:px-8 bg-gray-50 border-y border-gray-200 scroll-mt-16">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-sm font-sans font-semibold uppercase tracking-[0.15em] text-gray-500 mb-6">Dealer's Choice</h2>
        <p class="text-gray-700 max-w-2xl leading-relaxed mb-3">
          Home-game poker variants: {myGames.length} original, {learnedGames.length} learned. All are <strong>pot limit</strong> and <strong>bomb pots</strong> unless noted; standard Texas Hold'em rules apply.
        </p>
        <p class="text-sm text-gray-500 mb-10">
          Playable online, with friends or bots: <a href="https://dealer-s-choice.vercel.app/" target="_blank" rel="noopener noreferrer" class="border-b border-gray-400 hover:border-black transition-colors">dealer-s-choice.vercel.app</a>. <a href="/work#projects" class="border-b border-gray-400 hover:border-black transition-colors">Project details</a>.
        </p>

        <h3 class="text-xl font-semibold mb-6">Original variants</h3>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-14">
          {myGames.map(game => (
            <details id={`game-${game.slug}`} class="poker-rule">
              <summary><h4 class="text-lg font-semibold">{game.data.name}</h4><span aria-hidden="true">+</span></summary>
              <p class="text-sm italic text-gray-500 mb-3">"{game.data.quote}"</p>
              <p class="text-gray-600 mb-4 leading-relaxed">{game.data.description}</p>
              <ol class="space-y-2 text-base text-gray-600 list-decimal list-outside pl-5">
                {game.data.rules.map(rule => <li class="pl-1">{rule}</li>)}
              </ol>
            </details>
          ))}
        </div>

        <h3 class="text-xl font-semibold mb-6">Learned variants</h3>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {learnedGames.map(game => (
            <details id={`game-${game.slug}`} class="poker-rule">
              <summary><h4 class="text-lg font-semibold">{game.data.name}</h4><span aria-hidden="true">+</span></summary>
              <p class="text-sm italic text-gray-500 mb-3">"{game.data.quote}"</p>
              <p class="text-gray-600 mb-4 leading-relaxed">{game.data.description}</p>
              <ol class="space-y-2 text-base text-gray-600 list-decimal list-outside pl-5">
                {game.data.rules.map(rule => <li class="pl-1">{rule}</li>)}
              </ol>
            </details>
          ))}
        </div>

        <div class="mt-14 border-t border-gray-300 pt-6">
          <h3 class="text-base font-semibold mb-5">Terminology</h3>
          <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-4 text-sm">
            <div><dt class="font-medium inline">Bomb pot — </dt><dd class="text-gray-600 inline">All players ante before cards are dealt. No pre-flop betting; action starts at the flop.</dd></div>
            <div><dt class="font-medium inline">Pot limit — </dt><dd class="text-gray-600 inline">Maximum bet or raise cannot exceed the current pot size.</dd></div>
            <div><dt class="font-medium inline">Double board — </dt><dd class="text-gray-600 inline">Two separate community boards are dealt; the pot typically splits between the winners of each.</dd></div>
            <div><dt class="font-medium inline">BB — </dt><dd class="text-gray-600 inline">Big blind. The standard betting unit; 1BB is the minimum bet for that game.</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Writing -->
    <section id="writing" class="py-14 px-4 sm:px-6 lg:px-8 scroll-mt-16">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-sm font-sans font-semibold uppercase tracking-[0.15em] text-gray-500 mb-8">Writing</h2>

        <h3 class="text-xl font-semibold mb-6">Poems</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-14">
          {poems.map(poem => (
            <div class="border-t border-gray-300 pt-5">
              <span class="text-xs uppercase tracking-wide text-gray-500">{poem.category}</span>
              <h4 class="text-lg font-semibold mt-1 mb-1">{poem.title}</h4>
              <p class="text-sm text-gray-500 mb-4">{poem.date}</p>
              <p class="text-gray-600 italic leading-relaxed whitespace-pre-line font-serif">{poem.excerpt}</p>
              <a href={`/poems/${poem.slug}`} class="inline-block mt-4 text-sm text-gray-500 hover:text-black transition-colors">Read →</a>
            </div>
          ))}
        </div>

        <h3 class="text-xl font-semibold mb-6">Prose</h3>
        <div class="space-y-10 max-w-3xl">
          {articles.map(article => (
            <div class="border-t border-gray-300 pt-5">
              <h4 class="text-lg font-semibold mb-1">{article.title}</h4>
              <p class="text-sm text-gray-500 mb-4">{article.date} · {article.readTime} read</p>
              <p class="text-gray-600 leading-relaxed font-serif">{article.excerpt}</p>
              <div class="flex flex-wrap gap-x-3 gap-y-1 mt-4 text-xs text-gray-500">
                {article.tags.map(tag => <span>{tag}</span>)}
              </div>
              <a href={`/articles/${article.slug}`} class="inline-block mt-4 text-sm text-gray-500 hover:text-black transition-colors">Read →</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Quotes -->
    <section id="quotes" class="py-14 px-4 sm:px-6 lg:px-8 bg-gray-50 border-y border-gray-200 scroll-mt-16">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-sm font-sans font-semibold uppercase tracking-[0.15em] text-gray-500 mb-8">Quotes</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-9">
          {quotes.map(quote => (
            <div class="border-t border-gray-300 pt-5">
              <blockquote class="font-serif italic text-gray-700 leading-relaxed mb-3">"{quote.text}"</blockquote>
              <p class="text-sm text-gray-500">— {quote.author}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Elsewhere -->
    <section id="elsewhere" class="py-14 px-4 sm:px-6 lg:px-8 scroll-mt-16">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-sm font-sans font-semibold uppercase tracking-[0.15em] text-gray-500 mb-8">Elsewhere</h2>

        <div class="border-t border-gray-300 pt-6 mb-10">
          <h3 class="text-base font-semibold mb-5">Interests</h3>
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-600">
            {interests.map(item => <span>{item}</span>)}
          </div>
        </div>

        <div class="border-t border-gray-300 pt-6">
          <h3 class="text-base font-semibold mb-5">Sports</h3>
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
            {sports.map(sport => (
              <span class="text-gray-600">
                {sport.name}
                <span class="text-gray-400 ml-1.5">{sport.level}</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script>
  function openLinkedGame() {
    const id = decodeURIComponent(location.hash.slice(1));
    const game = document.getElementById(id);
    if (game instanceof HTMLDetailsElement) game.open = true;
  }
  openLinkedGame();
  window.addEventListener('hashchange', openLinkedGame);
</script>
