---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import about from '../data/about.json';

const { interests } = about;
---
<Layout title="About — Mingxi Yan" description="About Mingxi Yan: AI systems engineer and MS student at Carnegie Mellon’s Language Technologies Institute.">
  <Navigation />
  <main id="main-content">
    <section class="page-shell about-opening">
      <h1>Mingxi Yan</h1>
      <div class="about-story">
        {about.opening.map(p => <p>{p}</p>)}
        <a class="text-link" href="/work">Work</a>
      </div>
    </section>
    <section class="page-shell about-interests">
      <div class="section-heading"><div><h2>Interests</h2></div></div>
      <div class="about-grid">{interests.map(item => <article><h3>{item.title}</h3><p>{item.text}</p>{item.href && <a class="text-link" href={item.href}>{item.link}</a>}</article>)}</div>
    </section>
    <section class="page-shell about-closing">
      <h2>Contact</h2>
      <p>{about.contact}</p>
      <a class="text-link" href="mailto:mingxiy66@gmail.com">Email</a>
    </section>

    <p class="self-note page-shell">{about.selfNote}</p>
  </main>
  <Footer />
</Layout>
